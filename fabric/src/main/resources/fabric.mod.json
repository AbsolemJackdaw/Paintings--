{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "Subaraki",
    "StrikerRocker"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/paintings-fabric-edition",
    "sources": "https://github.com/ArtixAllMighty/PaintingsFabric",
    "issues": "https://github.com/ArtixAllMighty/PaintingsFabric/issues"
  },
  "license": "${license}",
  "icon": "banner.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "subaraki.paintings.mod.Paintings"
    ],
    "client": [
      "subaraki.paintings.mod.PaintingsClient"
    ],
    "modmenu": [
      "subaraki.paintings.util.ModMenuConfigScreen"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric": "*",
    "cloth-config2": ">=7.0.0"
  }
}
